+ * barrier at initialize. Imabikisou's Sofdec decoder SPUs notify a barrier
+ * the PPU polls with TryWait, and the boot waited on it forever.
+ *
+ * Arrivals count `value` up and the last one sets bit 15; waiters then count
+ * it back down and the last one clears it (RPCS3 cellSync try_notify and
+ * try_wait). One step of either, or 0 if it cannot proceed yet. */
+static int barrier_step(CellSyncBarrier* b, uint32_t ea, int wait)
+{
+    for (;;) {
+        uint32_t raw = atomic_load(&b->ctrl);
+        uint32_t g   = sync_bswap32(raw);
